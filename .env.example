# Lokal ishlash uchun namuna. Nusxa oling: cp .env.example .env
# Render'da bu qiymatlar panel / render.yaml orqali beriladi — .env repoga tushmaydi.

DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change-me-please

# Bo'sh bo'lsa lokal PGlite (data/ papkasi) ishlatiladi.
# DATABASE_URL=postgres://user:pass@localhost:5432/dashboard

# ELD tokenlarini bazada shifrlash kaliti (production'da majburiy).
# SECRET_KEY=

# Ixtiyoriy: tarozilar uchun Google Places to'ldiruvchisi.
# GOOGLE_MAPS_API_KEY=

# REFRESH_INTERVAL_SEC=60
# PORT=3000

# Lokal sinov: login sahifasidagi "Continue as default user" (production'da har doim o'chiq).
# DEV_LOGIN=0
